<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop.controller.LoginController">

    <VBox alignment="CENTER" spacing="15.0"
          prefWidth="360.0" prefHeight="420.0"
          layoutX="220.0" layoutY="40.0"
          style="-fx-background-color: #16213e; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0, 0, 5);">

        <padding>
            <Insets top="40.0" bottom="40.0" left="40.0" right="40.0"/>
        </padding>

        <!-- Title -->
        <Label text="HOSTEL MANAGEMENT"
               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>

        <Label text="SYSTEM"
               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>

        <Label text="Admin Login"
               style="-fx-text-fill: #a8a8b3;">
            <font>
                <Font size="13.0"/>
            </font>
        </Label>

        <!-- Spacing -->
        <VBox spacing="0.0" prefHeight="10.0"/>

        <!-- Username -->
        <Label text="Username"
               style="-fx-text-fill: #ffffff;">
            <font>
                <Font size="13.0"/>
            </font>
        </Label>

        <TextField fx:id="usernameField"
                   promptText="Enter username"
                   prefHeight="40.0" prefWidth="280.0"
                   style="-fx-background-color: #0f3460; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 8; -fx-border-color: #e94560; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 5 10 5 10;">
            <font>
                <Font size="13.0"/>
            </font>
        </TextField>

        <!-- Password -->
        <Label text="Password"
               style="-fx-text-fill: #ffffff;">
            <font>
                <Font size="13.0"/>
            </font>
        </Label>

        <PasswordField fx:id="passwordField"
                       promptText="Enter password"
                       prefHeight="40.0" prefWidth="280.0"
                       style="-fx-background-color: #0f3460; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 8; -fx-border-color: #e94560; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 5 10 5 10;">
            <font>
                <Font size="13.0"/>
            </font>
        </PasswordField>

        <!-- Error Label -->
        <Label fx:id="errorLabel"
               text=""
               style="-fx-text-fill: #e94560;"
               visible="false">
            <font>
                <Font size="12.0"/>
            </font>
        </Label>

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="LOGIN"
                prefHeight="42.0" prefWidth="280.0"
                onAction="#handleLogin"
                style="-fx-background-color: #e94560; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Button>

        <!-- Footer -->
        <Label text="Friends Hostel © 2026"
               style="-fx-text-fill: #a8a8b3;">
            <font>
                <Font size="11.0"/>
            </font>
        </Label>

    </VBox>

</AnchorPane>
