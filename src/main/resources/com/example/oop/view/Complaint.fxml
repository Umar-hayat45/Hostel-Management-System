<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="635.0" prefWidth="880.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop.controller.ComplaintController">

    <VBox spacing="15.0"
          AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">

        <!-- Title -->
        <Label text="Complaint Management"
               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="22.0"/></font>
        </Label>

        <!-- Input Form -->
        <VBox spacing="10.0" style="-fx-background-color: #16213e; -fx-background-radius: 10;">
            <padding><Insets top="15.0" bottom="15.0" left="15.0" right="15.0"/></padding>

            <Label text="Submit New Complaint" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;">
                <font><Font size="14.0"/></font>
            </Label>

            <HBox spacing="10.0">
                <VBox spacing="5.0">
                    <Label text="Complaint ID" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="complaintIdField" promptText="e.g. C001" prefWidth="120.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Student ID" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="studentIdField" promptText="e.g. S001" prefWidth="120.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Category" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <ComboBox fx:id="categoryCombo" prefWidth="150.0" prefHeight="35.0"
                              style="-fx-background-color: #0f3460; -fx-mark-color: white; -fx-background-radius: 6;"/>
                </VBox>
            </HBox>

            <HBox spacing="10.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Description" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextArea fx:id="descriptionArea" promptText="Describe the complaint..."
                              prefHeight="65.0" prefWidth="400.0"
                              style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"
                              wrapText="true"/>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Resolution" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextArea fx:id="resolutionArea" promptText="Enter resolution (to resolve complaint)..."
                              prefHeight="65.0" prefWidth="400.0"
                              style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #0f3460; -fx-border-radius: 6; -fx-border-width: 1;"
                              wrapText="true"/>
                </VBox>
            </HBox>

            <!-- Buttons -->
            <HBox spacing="10.0">
                <Button text="➕  Submit Complaint" prefHeight="35.0" prefWidth="170.0"
                        onAction="#handleSubmitComplaint"
                        style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;">
                    <font><Font size="12.0"/></font>
                </Button>
                <Button text="⏳  Mark In Progress" prefHeight="35.0" prefWidth="160.0"
                        onAction="#handleMarkInProgress"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                    <font><Font size="12.0"/></font>
                </Button>
                <Button text="✔  Resolve" prefHeight="35.0" prefWidth="110.0"
                        onAction="#handleResolve"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                    <font><Font size="12.0"/></font>
                </Button>
                <Button text="✖  Clear" prefHeight="35.0" prefWidth="90.0"
                        onAction="#handleClear"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                    <font><Font size="12.0"/></font>
                </Button>
                <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e94560;">
                    <font><Font size="12.0"/></font>
                </Label>
            </HBox>

        </VBox>

        <!-- Filter Row -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Filter:" style="-fx-text-fill: #a8a8b3;"><font><Font size="13.0"/></font></Label>
            <Button text="All" prefHeight="32.0" prefWidth="70.0"
                    onAction="#handleShowAll"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
            <Button text="Pending" prefHeight="32.0" prefWidth="90.0"
                    onAction="#handleShowPending"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
            <Button text="In Progress" prefHeight="32.0" prefWidth="100.0"
                    onAction="#handleShowInProgress"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
            <Button text="Resolved" prefHeight="32.0" prefWidth="90.0"
                    onAction="#handleShowResolved"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
        </HBox>

        <!-- Table -->
        <TableView fx:id="complaintTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #16213e; -fx-border-color: #0f3460;">
            <columns>
                <TableColumn fx:id="colId"          text="ID"          prefWidth="70.0"/>
                <TableColumn fx:id="colStudentId"   text="Student ID"  prefWidth="90.0"/>
                <TableColumn fx:id="colCategory"    text="Category"    prefWidth="100.0"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="180.0"/>
                <TableColumn fx:id="colDate"        text="Date"        prefWidth="100.0"/>
                <TableColumn fx:id="colStatus"      text="Status"      prefWidth="100.0"/>
                <TableColumn fx:id="colResolution"  text="Resolution"  prefWidth="200.0"/>
            </columns>
        </TableView>

    </VBox>

</AnchorPane>