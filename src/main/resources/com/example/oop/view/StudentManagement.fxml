<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="635.0" prefWidth="880.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop.controller.StudentController">

    <VBox spacing="15.0"
          AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">

        <!-- Title -->
        <Label text="Student Management"
               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
            <font><Font name="System Bold" size="22.0"/></font>
        </Label>

        <!-- Input Form -->
        <VBox spacing="12.0" style="-fx-background-color: #16213e; -fx-background-radius: 10;">
            <padding><Insets top="15.0" bottom="15.0" left="15.0" right="15.0"/></padding>

            <Label text="Add / Edit Student" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;">
                <font><Font size="14.0"/></font>
            </Label>

            <!-- Row 1: ID, Name, Age, Email, Phone -->
            <HBox spacing="10.0">
                <VBox spacing="5.0">
                    <Label text="Student ID" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="idField" promptText="e.g. S001" prefWidth="120.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Full Name" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="nameField" promptText="Full name" prefWidth="160.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Age" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="ageField" promptText="Age" prefWidth="65.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Email" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="emailField" promptText="Email address" prefWidth="170.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Phone" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="phoneField" promptText="Phone" prefWidth="130.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
            </HBox>

            <!-- Row 2: Course, Year, Fees -->
            <HBox spacing="10.0">
                <VBox spacing="5.0">
                    <Label text="Course" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="courseField" promptText="e.g. CS, BBA" prefWidth="130.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Year" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <ComboBox fx:id="yearCombo" prefWidth="80.0" prefHeight="35.0"
                              style="-fx-background-color: #0f3460; -fx-mark-color: white; -fx-background-radius: 6;"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Total Fees (Rs.)" style="-fx-text-fill: #a8a8b3;"><font><Font size="12.0"/></font></Label>
                    <TextField fx:id="feesField" promptText="e.g. 50000" prefWidth="130.0" prefHeight="35.0"
                               style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #e94560; -fx-border-radius: 6; -fx-border-width: 1;"/>
                </VBox>
            </HBox>

            <!-- Row 3: All Buttons in one clean row -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="➕  Add Student" prefWidth="140.0" prefHeight="38.0"
                        onAction="#handleAddStudent"
                        style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;">
                </Button>
                <Button text="✏  Update" prefWidth="120.0" prefHeight="38.0"
                        onAction="#handleUpdateStudent"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: #1a1a2e; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;">
                </Button>
                <Button text="🗑  Delete" prefWidth="110.0" prefHeight="38.0"
                        onAction="#handleDeleteStudent"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;">
                </Button>
                <Button text="✖  Clear" prefWidth="100.0" prefHeight="38.0"
                        onAction="#handleClear"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;">
                </Button>
                <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e94560;">
                    <font><Font size="12.0"/></font>
                </Label>
            </HBox>

        </VBox>

        <!-- Search Bar -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Search:" style="-fx-text-fill: #a8a8b3;"><font><Font size="13.0"/></font></Label>
            <TextField fx:id="searchField" promptText="Search by name..." prefWidth="250.0" prefHeight="35.0"
                       style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 6; -fx-border-color: #0f3460; -fx-border-radius: 6; -fx-border-width: 1;"/>
            <Button text="🔍 Search" prefHeight="35.0" prefWidth="100.0"
                    onAction="#handleSearch"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
            <Button text="Show All" prefHeight="35.0" prefWidth="90.0"
                    onAction="#handleShowAll"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
                <font><Font size="12.0"/></font>
            </Button>
        </HBox>

        <!-- Table -->
        <TableView fx:id="studentTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #16213e; -fx-border-color: #0f3460;">
            <columns>
                <TableColumn fx:id="colId"     text="ID"         prefWidth="70.0"/>
                <TableColumn fx:id="colName"   text="Name"       prefWidth="140.0"/>
                <TableColumn fx:id="colAge"    text="Age"        prefWidth="55.0"/>
                <TableColumn fx:id="colCourse" text="Course"     prefWidth="80.0"/>
                <TableColumn fx:id="colYear"   text="Year"       prefWidth="55.0"/>
                <TableColumn fx:id="colRoom"   text="Room"       prefWidth="100.0"/>
                <TableColumn fx:id="colFees"   text="Total Fees" prefWidth="100.0"/>
                <TableColumn fx:id="colPaid"   text="Paid"       prefWidth="100.0"/>
                <TableColumn fx:id="colStatus" text="Status"     prefWidth="80.0"/>
            </columns>
        </TableView>

    </VBox>

</AnchorPane>