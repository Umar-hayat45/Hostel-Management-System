<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.oop.controller.DashboardController">

    <!-- TOP BAR -->
    <top>
        <HBox prefHeight="65.0" prefWidth="1100.0"
              alignment="CENTER_LEFT" spacing="20.0"
              style="-fx-background-color: #16213e; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);">
            <padding>
                <Insets top="0.0" bottom="0.0" left="30.0" right="30.0"/>
            </padding>

            <Label text="🏠" style="-fx-text-fill: #e94560;">
                <font><Font size="24.0"/></font>
            </Label>

            <Label text="Hostel Management System"
                   style="-fx-text-fill: #ffffff; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="20.0"/></font>
            </Label>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="welcomeLabel"
                   text="Welcome, Admin"
                   style="-fx-text-fill: #a8a8b3;">
                <font><Font size="13.0"/></font>
            </Label>

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;">
                <font><Font size="12.0"/></font>
            </Button>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220.0" prefHeight="700.0" spacing="8.0"
              style="-fx-background-color: #16213e;">
            <padding>
                <Insets top="30.0" bottom="30.0" left="15.0" right="15.0"/>
            </padding>

            <Label text="NAVIGATION"
                   style="-fx-text-fill: #a8a8b3; -fx-font-weight: bold;">
                <font><Font size="11.0"/></font>
            </Label>

            <Button fx:id="btnDashboard" text="📊  Dashboard"
                    prefWidth="190.0" prefHeight="42.0"
                    onAction="#showDashboardHome"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <font><Font size="13.0"/></font>
            </Button>

            <Button fx:id="btnStudents" text="👨‍🎓  Students"
                    prefWidth="190.0" prefHeight="42.0"
                    onAction="#showStudents"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <font><Font size="13.0"/></font>
            </Button>

            <Button fx:id="btnRooms" text="🚪  Rooms"
                    prefWidth="190.0" prefHeight="42.0"
                    onAction="#showRooms"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <font><Font size="13.0"/></font>
            </Button>

            <Button fx:id="btnPayments" text="💰  Payments"
                    prefWidth="190.0" prefHeight="42.0"
                    onAction="#showPayments"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <font><Font size="13.0"/></font>
            </Button>

            <Button fx:id="btnComplaints" text="📋  Complaints"
                    prefWidth="190.0" prefHeight="42.0"
                    onAction="#showComplaints"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <font><Font size="13.0"/></font>
            </Button>

        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <AnchorPane fx:id="contentArea"
                    style="-fx-background-color: #1a1a2e;">

            <!-- Default Dashboard Home Content -->
            <VBox fx:id="dashboardHomeContent" alignment="CENTER" spacing="30.0"
                  AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

                <Label text="Welcome to Hostel Management System"
                       style="-fx-text-fill: #ffffff; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>

                <Label text="Use the navigation menu on the left to manage your hostel."
                       style="-fx-text-fill: #a8a8b3;">
                    <font><Font size="14.0"/></font>
                </Label>

                <!-- Stats Row -->
                <HBox spacing="20.0" alignment="CENTER">

                    <VBox prefWidth="180.0" prefHeight="100.0" alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #16213e; -fx-background-radius: 12;">
                        <Label fx:id="totalStudentsLabel" text="0"
                               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="32.0"/></font>
                        </Label>
                        <Label text="Total Students" style="-fx-text-fill: #a8a8b3;">
                            <font><Font size="13.0"/></font>
                        </Label>
                    </VBox>

                    <VBox prefWidth="180.0" prefHeight="100.0" alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #16213e; -fx-background-radius: 12;">
                        <Label fx:id="totalRoomsLabel" text="0"
                               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="32.0"/></font>
                        </Label>
                        <Label text="Total Rooms" style="-fx-text-fill: #a8a8b3;">
                            <font><Font size="13.0"/></font>
                        </Label>
                    </VBox>

                    <VBox prefWidth="180.0" prefHeight="100.0" alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #16213e; -fx-background-radius: 12;">
                        <Label fx:id="totalComplaintsLabel" text="0"
                               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="32.0"/></font>
                        </Label>
                        <Label text="Pending Complaints" style="-fx-text-fill: #a8a8b3;">
                            <font><Font size="13.0"/></font>
                        </Label>
                    </VBox>

                    <VBox prefWidth="180.0" prefHeight="100.0" alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #16213e; -fx-background-radius: 12;">
                        <Label fx:id="totalRevenueLabel" text="Rs.0"
                               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28.0"/></font>
                        </Label>
                        <Label text="Total Revenue" style="-fx-text-fill: #a8a8b3;">
                            <font><Font size="13.0"/></font>
                        </Label>
                    </VBox>

                </HBox>

            </VBox>

        </AnchorPane>
    </center>

    <!-- BOTTOM BAR -->
    <bottom>
        <HBox prefHeight="30.0" alignment="CENTER"
              style="-fx-background-color: #16213e;">
            <Label text="Green Valley Hostel © 2025  |  Developed with JavaFX"
                   style="-fx-text-fill: #a8a8b3;">
                <font><Font size="11.0"/></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>